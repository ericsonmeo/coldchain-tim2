    {
        "id": "d477923d397703f7",
        "type": "function",
        "z": "47f2439dc8f66dc7",
        "name": "coldchain data",
        "func": "const data = msg.payload;\n\n// Pastikan payload memiliki struktur telemetry\nif (!data || !data.metrics || !data.device_id) {\n    node.warn(\"Format telemetry tidak valid\");\n    return null;\n}\n\nmsg.measurement = \"coldchain_telemetry\";\n\nmsg.payload = [\n    {\n        temp_c: Number(data.metrics.temp_c),\n        humidity_pct: Number(data.metrics.humidity_pct),\n        door_open: Boolean(data.metrics.door_open),\n        battery_pct: Number(data.metrics.battery_pct),\n        rssi_dbm: Number(data.metrics.rssi_dbm)\n    },\n    {\n        device_id: data.device_id,\n        domain: data.domain,\n        gedung: data.gedung,\n        ruang: data.ruang\n    }\n];\n\nmsg.timestamp = data.ts;\n\nreturn msg;",
